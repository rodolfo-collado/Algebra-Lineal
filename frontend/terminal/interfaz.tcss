Screen {
    background: $background;
    color: $foreground;
}

#marca {
    width: 1fr;
    height: 5;
    content-align: center middle;
}
.marca-breve #marca { height: 1; }

#cuerpo {
    height: 1fr;
    layout: vertical;
}
#resultados {
    height: 1fr;
    min-height: 2;
    padding: 0 1;
    scrollbar-size: 1 1;
    border: solid $panel;
}
#chat {
    height: auto;
    max-height: 75%;
    overflow-y: auto;
    scrollbar-size: 1 1;
    padding: 0 1;
    background: $surface;
    border: solid $panel;
}
.ancha #cuerpo { layout: horizontal; }
.ancha #resultados { width: 2fr; }
.ancha #chat { width: 1fr; height: 1fr; max-height: 100%; }

.titulo, #migas {
    color: $secondary;
    text-style: bold;
}
#pregunta, #aviso { height: auto; }
#aviso { color: $error; display: none; }
#menu { height: auto; max-height: 7; color: $secondary; }
#entrada {
    height: 1;
    border: none;
    padding: 0 1;
    background: $panel;
    color: $primary;
}
#entrada:focus { border: none; }
#teclas {
    height: 1;
    padding: 0 1;
    color: $foreground 75%;
    text-wrap: nowrap;
}

#respuestas { color: $foreground 70%; height: auto; }
#ayuda { color: $foreground 80%; height: auto; }
#editor {
    display: none;
    height: 5;
    border: none;
    padding: 0 1;
    background: $panel;
}
#editor:focus { border: none; }
.ejercicio { padding: 0; margin: 0; }
.ejercicio Contents { padding: 0 1; }
.holgada .ejercicio { margin-bottom: 1; }
.holgada .ejercicio Static { margin-bottom: 1; }
.corta #respuestas, #respuestas.vacio, #ayuda.vacio { display: none; }
.veredicto { color: $accent; text-style: bold; }
.etiqueta { color: $primary; }
TablaInteractiva { margin: 0; }

Grafica { height: auto; padding: 0; color: $primary; text-wrap: nowrap; }
Grafica:focus { background: $surface; }
GraficaConjuntos { height: auto; }
ArchivosBackend { height: auto; max-height: 10; padding: 0; }

Paleta { align: center middle; background: $background 70%; }
#paleta { width: 50; max-width: 95%; height: auto; padding: 0 1; border: solid $secondary; background: $surface; }
#paleta OptionList { height: auto; max-height: 12; }
